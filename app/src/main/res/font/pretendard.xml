<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- Regular (400) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/pretendard_400"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/pretendard_400" />
    
    <!-- Medium (500) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/pretendard_500"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/pretendard_500" />
    
    <!-- SemiBold (600) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/pretendard_600"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/pretendard_600" />
</font-family>
